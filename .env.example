# The Handmade Craft — Environment Configuration Example

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Business Contact (Configured to +91 8271735190)
NEXT_PUBLIC_WHATSAPP_NUMBER=918271735190

# Supabase Managed Database & Auth (ap-south-1 Mumbai)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Transaction Pooled Postgres Connection
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Cloudinary Media Pipeline
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=thehandmadecraft
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Initial Admin Email
ADMIN_INITIAL_EMAIL=owner@thehandmadecraft.in
