# Bloomora — Environment Configuration Example

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# WhatsApp Business Contact (Configured to +91 8271735190)
NEXT_PUBLIC_WHATSAPP_NUMBER=918271735190

# Supabase Managed Database & Auth (From your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Transaction Pooled Postgres Connection (From Supabase Project Settings -> Database)
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Cloudinary Media Pipeline (Optional)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=bloomora
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Initial Admin Portal Credentials & Signed Session Secret
ADMIN_INITIAL_EMAIL=admin@bloomora.in
ADMIN_CREDENTIAL_EMAIL=admin@bloomora.in
ADMIN_CREDENTIAL_PASSWORD=replace-with-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-64-char-random-hex-secret

